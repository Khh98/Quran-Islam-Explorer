# Copy this file to .streamlit/secrets.toml for local runs (never commit the real file).
# On Streamlit Community Cloud paste the same lines in: App settings -> Secrets.

OPENAI_API_KEY = "sk-proj-..."

# Optional: override the model that writes the surah lessons
# OPENAI_MODEL = "gpt-5.6-sol"

# Optional: override the narrator (speech) model, e.g. when OpenAI retires the current one
# OPENAI_TTS_MODEL = "gpt-4o-mini-tts-2025-12-15"
